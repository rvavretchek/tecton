{
  "name": "@tecton/auth",
  "version": "0.0.0",
  "description": "Ready-to-run Auth service: credentials, EdDSA JWT, JWKS, confined refresh",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.19 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "prisma",
    "tecton.yaml"
  ],
  "tecton": {
    "manifests": [
      "./tecton.yaml"
    ]
  },
  "scripts": {
    "generate": "prisma generate --config prisma/postgresql/prisma.config.ts && prisma generate --config prisma/mysql/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tecton/core": "workspace:*",
    "@tecton/manifest": "workspace:*",
    "@tecton/providers": "workspace:*",
    "jose": "6.2.12",
    "prisma": "7.10.0",
    "uuid": "14.0.3"
  }
}
