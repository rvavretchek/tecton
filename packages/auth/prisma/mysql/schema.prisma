// Auth service schema, mysql dialect. Keep it identical to the other dialect except for
// native @db types: schema-parity.test.ts compares them. Only the Auth service uses this
// database (AD-9). Timestamps come from the Clock port, never from database defaults.
generator client {
  provider               = "prisma-client"
  output                 = "../../src/generated/mysql"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model Credential {
  id              String          @id @db.Char(36)
  login           String          @unique @db.VarChar(320)
  passwordHash    String          @map("password_hash") @db.VarChar(256)
  status          String          @db.VarChar(16)
  permissions     Json
  createdAt       DateTime        @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @map("updated_at") @db.DateTime(3)
  refreshFamilies RefreshFamily[]

  @@map("credentials")
}

// Story 2.3: one family per login session. It expires a fixed time after the login; rotation never
// extends it. Revoking the family (logout, reuse, inactive credential) refuses every token in it.
model RefreshFamily {
  id            String         @id @db.Char(36)
  credentialId  String         @map("credential_id") @db.Char(36)
  credential    Credential     @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @map("created_at") @db.DateTime(3)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(3)
  revokedReason String?        @map("revoked_reason") @db.VarChar(16)
  tokens        RefreshToken[]

  @@index([credentialId])
  @@map("refresh_families")
}

// Only the SHA-256 of each opaque refresh token is stored, never the token itself.
model RefreshToken {
  id        String        @id @db.Char(36)
  familyId  String        @map("family_id") @db.Char(36)
  family    RefreshFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  createdAt DateTime      @map("created_at") @db.DateTime(3)
  usedAt    DateTime?     @map("used_at") @db.DateTime(3)

  @@index([familyId])
  @@map("refresh_tokens")
}
