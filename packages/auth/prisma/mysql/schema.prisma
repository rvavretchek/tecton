// Auth service schema, mysql dialect. Keep it identical to the other dialect except for
// native @db types: schema-parity.test.ts compares them. Only the Auth service uses this
// database (AD-9). Timestamps come from the Clock port, never from database defaults.
generator client {
  provider               = "prisma-client"
  output                 = "../../src/generated/mysql"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model Credential {
  id           String   @id @db.Char(36)
  login        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(256)
  status       String   @db.VarChar(16)
  permissions  Json
  createdAt    DateTime @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @map("updated_at") @db.DateTime(3)

  @@map("credentials")
}
