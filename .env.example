# Test configuration reference. Nothing loads this file automatically: export the
# variables in your shell (or your editor's test runner settings) before running tests.

# Database engine for *.persistence.test.ts: postgres | mariadb | mysql (default: postgres)
TECTON_TEST_DB=postgres

# Base URL of a running Tecton workspace (the Gateway) for Playwright API/E2E tests.
# Leave unset to skip them.
# BASE_URL=http://localhost:3000

# Docker engine used by Testcontainers. Only needed when Docker is not local.
# Never expose a remote engine as plain tcp://<host>:2375 (an unauthenticated root API).
# Testcontainers does not accept ssh:// here; forward the remote socket over SSH instead
# (local-only port, authenticated by SSH) and point container ports at the remote host:
#   ssh -N -L 127.0.0.1:23750:/var/run/docker.sock <user>@<host>
#   DOCKER_HOST=tcp://127.0.0.1:23750
#   TESTCONTAINERS_HOST_OVERRIDE=<host>
# Or TLS: DOCKER_HOST=tcp://<host>:2376 with DOCKER_TLS_VERIFY=1 and DOCKER_CERT_PATH.
# DOCKER_HOST=
# TESTCONTAINERS_HOST_OVERRIDE=
