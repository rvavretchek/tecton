# Test configuration reference. Nothing loads this file automatically: export the
# variables in your shell (or your editor's test runner settings) before running tests.

# Database engine for *.persistence.test.ts: postgres | mariadb | mysql (default: postgres)
TECTON_TEST_DB=postgres

# Base URL of a running Tecton workspace (the Gateway) for Playwright API/E2E tests.
# Leave unset to skip them.
# BASE_URL=http://localhost:3000

# Docker engine used by Testcontainers. Only needed when Docker is not local.
# Prefer SSH or TLS: plain tcp://<host>:2375 is an unauthenticated root API on the network.
#   DOCKER_HOST=ssh://user@<host>
#   DOCKER_HOST=tcp://<host>:2376 with DOCKER_TLS_VERIFY=1 and DOCKER_CERT_PATH
# DOCKER_HOST=
